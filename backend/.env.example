# Supply at least one provider key. Keep real credentials only in backend/.env.
GROQ_API_KEY=
GEMINI_API_KEY=

# Current Groq developer/free-tier replacement for the retired Llama 3.3 model.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash

# Leave blank to use temporary in-memory progress data during local development.
MONGODB_URI=
MONGODB_DATABASE=smart_study_agent
CHROMA_PERSIST_DIR=./data/chroma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Path to tesseract.exe, used to OCR scanned/image-only PDF pages that have no text layer.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
